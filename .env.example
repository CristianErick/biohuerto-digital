# ────────────────────────────────────────────────────────────
# Semillitas del Futuro — variables de entorno
# Copia este archivo como .env en desarrollo local.
# En Vercel/Railway/Render configúralas en el panel del proyecto.
# ────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final)
APP_URL=http://localhost/semillitas

# Depuración (NUNCA true en producción)
APP_DEBUG=false
APP_TIMEZONE=America/Lima

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=semillitas_db
DB_USER=root
DB_PASS=

# Conexión TLS (obligatoria en la mayoría de proveedores cloud)
DB_SSL=false
# DB_SSL_CA=/ruta/al/ca.pem
# También puedes pegar el contenido completo del certificado:
# DB_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DB_SSL_VERIFY=true

# Almacenamiento: db = MySQL (recomendado en cloud) | local = disco
STORAGE_DRIVER=db

# Sesiones: files = disco (local) | database = MySQL (Vercel/serverless)
SESSION_DRIVER=files
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=Lax

# Crea automáticamente las tablas archivos/app_data/sessions si faltan
DB_AUTO_MIGRATE=true

# Tamaño máximo por archivo (5 MB). En Vercel el límite de request es ~4.5 MB.
MAX_FILE_SIZE=5242880
